---
/** Ilustración de cada paso de la visita, con el lenguaje de la portada. */
interface Props { step: number }
const { step } = Astro.props;
const tooth = 'M19 6C10 6 5 13 6 22c.700 6 4 10 5.500 16C13 45 13 58 20 58c6 0 4-18 12-18s6 18 12 18c7 0 7-13 8.500-20C54 32 57.300 28 58 22c1-9-4-16-13-16-6 0-8 3-13 3s-7-3-13-3Z';
---
<svg class="step-art" viewBox="0 0 240 240" aria-hidden="true">
  <rect width="240" height="240" class="a-bg" />
  <circle cx="120" cy="122" r="84" class="a-sun" />
  <path d="M0 212c40-20 80-20 120 0s80 20 120 0v28H0Z" class="a-wave" />
  <g class="step-figure">
    {step === 0 && (
      <Fragment>
        <path d="M62 72h86a14 14 0 0 1 14 14v46a14 14 0 0 1-14 14H98l-24 22v-22H62a14 14 0 0 1-14-14V86a14 14 0 0 1 14-14Z" class="a-tooth" />
        <path d="M70 96h70M70 110h70M70 124h40" class="s-line" />
        <path d="M150 124h34a12 12 0 0 1 12 12v30a12 12 0 0 1-12 12v18l-20-18h-14a12 12 0 0 1-12-12v-30a12 12 0 0 1 12-12Z" class="a-coral" />
        <path d="M154 148c4 9 22 9 26 0" class="s-ink" />
      </Fragment>
    )}
    {step === 1 && (
      <Fragment>
        <path d={tooth} class="a-tooth" transform="translate(52 62) scale(1.900)" />
        <circle cx="150" cy="130" r="36" class="s-lens" />
        <path d="M176 157l26 28" class="s-handle" />
        <path d="M134 130l11 11 20-22" class="s-check" />
      </Fragment>
    )}
    {step === 2 && (
      <Fragment>
        <rect x="70" y="62" width="100" height="130" rx="12" class="a-tooth" />
        <rect x="96" y="52" width="48" height="22" rx="8" class="a-coral" />
        <path d="M86 100l7 7 12-14M86 130l7 7 12-14M86 160l7 7 12-14" class="s-check" />
        <path d="M118 102h36M118 132h36M118 162h24" class="s-line" />
      </Fragment>
    )}
    {step === 3 && (
      <Fragment>
        <rect x="60" y="74" width="112" height="104" rx="12" class="a-tooth" />
        <path d="M60 104V86a12 12 0 0 1 12-12h88a12 12 0 0 1 12 12v18Z" class="a-coral" />
        <path d="M88 62v22M144 62v22" class="s-handle" />
        <path d="M78 122h14M109 122h14M140 122h14M78 144h14M109 144h14M78 164h14" class="s-line" />
        <circle cx="160" cy="166" r="28" class="s-badge" />
        <path d="M148 166l9 9 17-19" class="s-check-light" />
      </Fragment>
    )}
  </g>
</svg>
